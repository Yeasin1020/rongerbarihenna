# Ei file ta copy kore ".env" naam dao, tarpor nicher value gula boshao

# ====== PostgreSQL (Neon) ======
# Neon dashboard > Connect > "Pooled connection" ON
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Same URL, kintu host theke "-pooler" bad
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ====== Website ======
# Live e tomar domain: https://rongerbari.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ====== Security ======
# 40+ character er jekono random lekha (keu jante parbe na emon)
JWT_SECRET=change-this-to-a-very-long-random-secret-string-123456

# ====== Prothom admin ======
# Database e kono admin na thakle prothom login e eta diye admin toiri hobe
ADMIN_EMAIL=admin@rongerbari.com
ADMIN_PASSWORD=admin12345

# ====== Cloudinary (chobi upload) ======
# cloudinary.com > Dashboard > "API Keys" theke. Na dile chobi database e save hobe.
# Ekta line e:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Othoba alada alada:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Kon folder e chobi jabe (optional)
CLOUDINARY_FOLDER=ronger-bari
